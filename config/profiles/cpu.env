# No GPU, little RAM (tested target: Intel 6th-gen Core, 4 cores, 8 GB RAM).
# Small model, Docling off (no OCR), tiny embedding model, no background LLM calls.
DESCRIPTION="CPU only - small model for testing on a low-RAM PC"
DEFAULT_PRESET=qwen35-2b-cpu
COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml
COMPOSE_PROFILES=
CONTENT_EXTRACTION_ENGINE=
TOOLS_DOCLING_URL=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_BACKGROUND_TASKS=false
RAG_TOP_K=4

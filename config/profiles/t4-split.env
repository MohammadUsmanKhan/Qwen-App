# 2× Tesla T4, layout B: LLM on GPU 0 only, GPU 1 kept free for image generation.
DESCRIPTION="2x Tesla T4 - LLM on GPU 0, GPU 1 free for images"
DEFAULT_PRESET=qwen36-35b-a3b-cpumoe
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu-split.yml
COMPOSE_PROFILES=docling
CONTENT_EXTRACTION_ENGINE=docling
TOOLS_DOCLING_URL=http://docling:5001
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
ENABLE_BACKGROUND_TASKS=true
RAG_TOP_K=8

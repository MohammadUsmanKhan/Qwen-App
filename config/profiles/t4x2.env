# 2× Tesla T4: main LLM split across both GPUs, Docling OCR on.
DESCRIPTION="2x Tesla T4 - LLM split across both GPUs"
DEFAULT_PRESET=qwen36-35b-a3b
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=docling
CONTENT_EXTRACTION_ENGINE=docling
TOOLS_DOCLING_URL=http://docling:5001
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
ENABLE_BACKGROUND_TASKS=true
RAG_TOP_K=8

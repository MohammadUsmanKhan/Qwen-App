# Qwen3.5-2B (vision via mmproj) on CPU — for testing on a small PC with 8 GB RAM.
# ~1.3 GB model + ~0.7 GB projector. Expect roughly 10-20 tokens/s on a 4-core desktop CPU.
HF_REPO=unsloth/Qwen3.5-2B-GGUF
HF_INCLUDE_MODEL="*Q4_K_M*.gguf *UD-Q4_K_XL*.gguf *Q4_K_S*.gguf *Q4_0*.gguf"
# F16 first: T4s have no BF16; any mmproj works on CPU.
HF_INCLUDE_MMPROJ="mmproj-F16.gguf *mmproj*f16*.gguf *mmproj*f32*.gguf *mmproj*.gguf"
MODEL_DIR=Qwen3.5-2B
LLM_ALIAS=qwen3.5-2b
# 16k fits a few uploaded documents; uses roughly 1 GB more RAM than 8k.
LLM_CTX=16384
LLM_PARALLEL=1
LLM_TENSOR_SPLIT=
LLM_THREADS=
LLM_N_GPU_LAYERS=0
LLM_FLASH_ATTN=auto
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
# Thinking mode roughly doubles response time on CPU; remove this to turn it back on.
LLM_EXTRA_ARGS="--reasoning-budget 0"

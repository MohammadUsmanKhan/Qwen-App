# Layout B2: Qwen3.6-35B-A3B on GPU 0 only, part of the expert weights in system RAM.
# Use with docker-compose.gpu-split.yml. Needs ~24 GB free system RAM.
# Raise --n-cpu-moe if GPU 0 runs out of memory, lower it for more speed.
HF_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
HF_INCLUDE_MODEL="*UD-Q4_K_M*.gguf *Q4_K_M*.gguf *UD-Q4_K_XL*.gguf *Q4_K_S*.gguf"
# F16 first: T4s have no BF16; any mmproj works on CPU.
HF_INCLUDE_MMPROJ="mmproj-F16.gguf *mmproj*f16*.gguf *mmproj*f32*.gguf *mmproj*.gguf"
MODEL_DIR=Qwen3.6-35B-A3B
LLM_ALIAS=qwen3.6-35b-a3b
LLM_CTX=16384
LLM_PARALLEL=1
LLM_TENSOR_SPLIT=1
LLM_THREADS=
LLM_N_GPU_LAYERS=999
LLM_FLASH_ATTN=on
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_EXTRA_ARGS="--n-cpu-moe 24"

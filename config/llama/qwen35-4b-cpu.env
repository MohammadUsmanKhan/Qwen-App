# Qwen3.5-4B (vision via mmproj) on CPU — better tool calling than 2B, about half the speed.
# ~2.7 GB model + projector; fits 8 GB RAM with the cpu profile (Docling off).
HF_REPO=unsloth/Qwen3.5-4B-GGUF
HF_INCLUDE_MODEL=*Q4_K_M*.gguf
HF_INCLUDE_MMPROJ=mmproj-F16.gguf
MODEL_DIR=Qwen3.5-4B
LLM_ALIAS=qwen3.5-4b
LLM_CTX=8192
LLM_PARALLEL=1
LLM_TENSOR_SPLIT=
LLM_THREADS=
LLM_N_GPU_LAYERS=0
LLM_FLASH_ATTN=auto
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_EXTRA_ARGS="--reasoning-budget 0"

# Qwen3.5-4B (vision via mmproj) on CPU — better tool calling than 2B, about half the speed.
# ~2.7 GB model + projector; fits 8 GB RAM with the cpu profile (Docling off).
HF_REPO=unsloth/Qwen3.5-4B-GGUF
HF_INCLUDE_MODEL="*Q4_K_M*.gguf *UD-Q4_K_XL*.gguf *Q4_K_S*.gguf *Q4_0*.gguf"
# F16 first: T4s have no BF16; any mmproj works on CPU.
HF_INCLUDE_MMPROJ="mmproj-F16.gguf *mmproj*f16*.gguf *mmproj*f32*.gguf *mmproj*.gguf"
MODEL_DIR=Qwen3.5-4B
LLM_ALIAS=qwen3.5-4b
# The model supports far more (~262k); the limits here are RAM and reading speed.
# 4B weights are twice the size of 2B, so 16k is the safe default on 8 GB RAM;
# with 16 GB+ try 32768. Check the memory it uses with `make doctor`.
LLM_CTX=16384
LLM_PARALLEL=1
LLM_TENSOR_SPLIT=
LLM_THREADS=
LLM_N_GPU_LAYERS=0
LLM_FLASH_ATTN=auto
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_EXTRA_ARGS="--reasoning-budget 0"

# Qwen3.8-27B (dense, vision-language). Check the licence on the model card first.
# Slower than the MoE on T4 bandwidth; benchmark with scripts/bench_llm.py.
HF_REPO=unsloth/Qwen3.8-27B-GGUF
HF_INCLUDE_MODEL="*Q4_K_M*.gguf *UD-Q4_K_XL*.gguf *Q4_K_S*.gguf *Q4_0*.gguf"
# F16 first: T4s have no BF16; any mmproj works on CPU.
HF_INCLUDE_MMPROJ="mmproj-F16.gguf *mmproj*f16*.gguf *mmproj*f32*.gguf *mmproj*.gguf"
MODEL_DIR=Qwen3.8-27B
LLM_ALIAS=qwen3.8-27b
LLM_CTX=16384
LLM_PARALLEL=1
LLM_TENSOR_SPLIT=1,1
LLM_THREADS=
LLM_N_GPU_LAYERS=999
LLM_FLASH_ATTN=on
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
LLM_EXTRA_ARGS=

# Copy to .env and edit:  cp .env.example .env
# Never commit .env — it holds secrets.

# ---------------------------------------------------------------- hardware profile
# Written by `make profile P=<t4x2|t4-split|cpu>`; see config/profiles/.
HW_PROFILE=t4x2
# Which compose files `docker compose` uses (':'-separated).
COMPOSE_FILE=docker-compose.yml
# Optional services to start. "docling" = OCR document extraction (~2-3 GB RAM).
COMPOSE_PROFILES=docling
# Upload text extraction in Open WebUI: "docling", or empty for the built-in extractor.
CONTENT_EXTRACTION_ENGINE=docling
# Tool server's Docling address; empty = use the built-in readers only.
TOOLS_DOCLING_URL=http://docling:5001
# Title/tag/follow-up generation after each message (extra LLM calls).
ENABLE_BACKGROUND_TASKS=true
RAG_TOP_K=8

# ---------------------------------------------------------------- images
# Pin these to exact tags/digests once the stack works (see README "Pinning").
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
DOCLING_IMAGE=quay.io/docling-project/docling-serve-cpu:latest

# ---------------------------------------------------------------- ports (host side)
WEBUI_PORT=3000
# Tool server must be reachable from users' browsers: download links point at it.
TOOLS_PORT=8001
# llama.cpp is bound to 127.0.0.1 only; Open WebUI reaches it on the docker network.
LLM_PORT=8080

# ---------------------------------------------------------------- main LLM
# Written by scripts/use_model.sh <preset>; presets live in config/llama/.
# Paths are relative to ./models (mounted read-only at /models).
LLM_PRESET=qwen36-35b-a3b
LLM_ALIAS=qwen3.6-35b-a3b
LLM_MODEL_FILE=Qwen3.6-35B-A3B/Qwen3.6-35B-A3B-Q4_K_M.gguf
LLM_MMPROJ_FILE=Qwen3.6-35B-A3B/mmproj-F16.gguf
LLM_CTX=32768
LLM_PARALLEL=2
LLM_TENSOR_SPLIT=1,1
# CPU threads for llama.cpp; empty = automatic (good default).
LLM_THREADS=
LLM_N_GPU_LAYERS=999
LLM_FLASH_ATTN=on
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q8_0
# Extra llama-server flags, space separated (e.g. "--n-cpu-moe 20").
LLM_EXTRA_ARGS=

# ---------------------------------------------------------------- Open WebUI
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me
WEBUI_NAME=Qwen Workspace
# First account created becomes admin; set to false after creating it.
ENABLE_SIGNUP=true
# Embeddings for RAG run on CPU inside Open WebUI.
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ---------------------------------------------------------------- tool server
# Shared secret between Open WebUI and the tool server. openssl rand -hex 32
TOOLS_API_KEY=change-me-too
# Secret for signing download links. openssl rand -hex 32
TOOLS_SIGNING_KEY=change-me-three
# Base URL users' browsers use to reach the tool server (for download links).
# Use the server's LAN hostname/IP, not localhost, if users are on other machines.
TOOLS_PUBLIC_URL=http://localhost:8001
# Download links expire after this many hours.
TOOLS_LINK_TTL_HOURS=168
LOG_LEVEL=INFO

# ---------------------------------------------------------------- research (Phase 8)
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=

# ---------------------------------------------------------------- Hugging Face
# Only needed for gated repos.
HF_TOKEN=
